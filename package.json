{
  "name": "@jackguo0310/dsh-recent-sessions",
  "version": "0.5.3",
  "description": "在 DSH 侧边栏工作区下方增加可折叠的「最近」会话分组，跨项目汇总近期会话，支持重命名/分叉/归档；会话跑完后可发 Windows 桌面通知。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client/client.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client/client.js && node --check scripts/gen-version.mjs",
    "version:meta": "node scripts/gen-version.mjs",
    "prepack": "npm run version:meta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackGuo0310/dsh-recent-sessions.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-alpha.1 <0.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "license": "MIT"
}